# Supabase (Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# IA (gateway do Lovable)
LOVABLE_API_KEY=

# Conexão OAuth das redes (Contas > "Conectar").
# O Client ID e o Client Secret de cada rede são cadastrados na própria tela Contas.
# URL pública do app; cada rede usa o retorno <APP_URL>/api/oauth/callback/<rede>.
APP_URL=
# Obrigatório: assina o state e cifra credenciais e tokens no banco.
# Não troque depois de usar: o que já foi cifrado deixa de ser legível (será preciso recadastrar).
OAUTH_STATE_SECRET=
