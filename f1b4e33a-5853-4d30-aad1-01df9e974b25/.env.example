# Supabase (Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA (gateway do Lovable)
LOVABLE_API_KEY=

# Conexão OAuth das redes (Contas > "Conectar agora")
# URL pública do app. Cadastre em cada rede o retorno <APP_URL>/api/oauth/callback/<rede>
# (instagram, facebook, tiktok, linkedin, youtube).
APP_URL=
# Assina o parâmetro state. Se vazio, deriva de SUPABASE_SERVICE_ROLE_KEY.
OAUTH_STATE_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# No TikTok, o "client key" vai em TIKTOK_CLIENT_ID.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Cliente OAuth do Google Cloud com a YouTube Data API ativada.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
